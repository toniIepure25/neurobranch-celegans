{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurobranch.local/schemas/claims.schema.json",
  "title": "NeuroBranch claims ledger",
  "type": "object",
  "required": [
    "schema_version",
    "statuses",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "statuses": {
      "type": "array",
      "items": {
        "enum": [
          "supported",
          "not_supported",
          "bounded_null",
          "underpowered"
        ]
      },
      "minItems": 4,
      "maxItems": 4
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "status",
          "test",
          "estimand",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "statement": {
            "type": "string",
            "minLength": 10
          },
          "status": {
            "enum": [
              "supported",
              "not_supported",
              "bounded_null",
              "underpowered"
            ]
          },
          "test": {
            "type": "string",
            "minLength": 3
          },
          "estimate": {
            "type": [
              "number",
              "null"
            ]
          },
          "ci_low": {
            "type": [
              "number",
              "null"
            ]
          },
          "ci_high": {
            "type": [
              "number",
              "null"
            ]
          },
          "margin": {
            "type": [
              "number",
              "null"
            ]
          },
          "mde": {
            "type": [
              "number",
              "null"
            ]
          },
          "equivalence_p": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "notes": {
            "type": "string"
          },
          "estimand": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "single_animal",
              "repeat",
              "pooled_fold",
              "animal_cluster",
              "superiority",
              "equivalence",
              "descriptive",
              null
            ]
          },
          "n_eval_animals": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "family": {
            "type": [
              "string",
              "null"
            ]
          },
          "p_value": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "p_holm": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
