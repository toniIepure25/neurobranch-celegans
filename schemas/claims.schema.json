{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurobranch.local/schemas/claims.schema.json",
  "title": "NeuroBranch claims ledger",
  "type": "object",
  "required": ["schema_version", "statuses", "claims"],
  "properties": {
    "schema_version": { "const": 1 },
    "statuses": {
      "type": "array",
      "items": { "enum": ["supported", "not_supported", "bounded_null", "underpowered"] },
      "minItems": 4,
      "maxItems": 4
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "status", "test", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "statement": { "type": "string", "minLength": 10 },
          "status": { "enum": ["supported", "not_supported", "bounded_null", "underpowered"] },
          "test": { "type": "string", "minLength": 3 },
          "estimate": { "type": ["number", "null"] },
          "ci_low": { "type": ["number", "null"] },
          "ci_high": { "type": ["number", "null"] },
          "margin": { "type": ["number", "null"] },
          "mde": { "type": ["number", "null"] },
          "equivalence_p": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
