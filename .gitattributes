reports/** text eol=lf

# Scientific Studio NPZ, JSON and PNG artifacts are byte-hashed in the manifest;
# keep exact bytes and never line-normalise them.
reports/scientific_studio/** -text -eol

# Kato interaction figures, tables and manifests are byte-hashed; keep exact bytes.
reports/simulator/kato_interactions/** -text

# The docs nav is hashed in the interaction manifest; keep a stable LF checkout.
mkdocs.yml text eol=lf

# Context-dynamics reports include raw-byte manifests, PNG figures and NPZ trajectories.
# Preserve their exact bytes so the declared raw SHA256 values remain verifiable.
reports/simulator/context_dynamics/** -text

# Binary simulator artifacts must never be line-normalised.
reports/simulator/latent_encoders/*.pt binary
reports/simulator/demo/*.npz binary
reports/simulator/failure_diagnostics/figures/** -text

reports/simulator/adaptive_dynamics/** -text
docs/assets/adaptive_dynamics/** -text

# Probabilistic report figures and CSV bytes are covered by manifest hashes.
reports/simulator/probabilistic_adaptive/** -text

# Uncertainty-calibration artifacts are covered by a SHA256 manifest.
reports/simulator/uncertainty_calibration/** -text

# Joint-dynamics artifacts are covered by a SHA256 manifest.
reports/simulator/joint_dynamics/** -text

# Common-state control artifacts are byte-hashed.
reports/simulator/kato_common_state/** -text

# Final audit includes PNG/PDF, UTF-16 logs and a SHA256 manifest; keep exact bytes.
reports/simulator/kato_final_audit/** -text

# Supervisor-handoff figures, PDFs and manifests are byte-hashed.
reports/simulator/supervisor_handoff/** -text

# Markdown sources are hashed in the handoff manifest; force stable LF checkout.
docs/HANDOFF_*.md text eol=lf

# The IC1-v2 freeze manifest verifies checkout bytes.
research/ic1_v2/** text eol=lf
scripts/ic1_msc_v2.py text eol=lf
scripts/ic1_v2_acceptance.py text eol=lf
src/neurobranch/abstraction/ic1_msc_oracle.py text eol=lf
src/neurobranch/abstraction/ic1_v2_*.py text eol=lf
tests/abstraction/test_ic1_msc_freeze.py text eol=lf
tests/abstraction/test_ic1_v2.py text eol=lf

# Existing inputs were fingerprinted from a CRLF checkout.
.python-version text eol=crlf
pyproject.toml text eol=crlf
uv.lock text eol=crlf
research/interventional_consistency_protocol.md text eol=crlf
research/interventional_consistency_protocol.sha256 text eol=crlf
src/neurobranch/__init__.py text eol=crlf
src/neurobranch/abstraction/__init__.py text eol=crlf
src/neurobranch/abstraction/commutation.py text eol=crlf
src/neurobranch/abstraction/estimands.py text eol=crlf
src/neurobranch/abstraction/reference.py text eol=crlf
src/neurobranch/abstraction/systems.py text eol=crlf
