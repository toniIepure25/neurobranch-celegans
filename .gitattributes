reports/** text eol=lf

# Context-dynamics reports include raw-byte manifests, PNG figures and NPZ trajectories.
# Preserve their exact bytes so the declared raw SHA256 values remain verifiable.
reports/simulator/context_dynamics/** -text

# Binary simulator artifacts must never be line-normalised.
reports/simulator/latent_encoders/*.pt binary
reports/simulator/demo/*.npz binary
reports/simulator/failure_diagnostics/figures/** -text

reports/simulator/adaptive_dynamics/** -text
docs/assets/adaptive_dynamics/** -text

# Probabilistic report figures and CSV bytes are covered by manifest hashes.
reports/simulator/probabilistic_adaptive/** -text

# Uncertainty-calibration artifacts are covered by a SHA256 manifest.
reports/simulator/uncertainty_calibration/** -text

# Joint-dynamics artifacts are covered by a SHA256 manifest.
reports/simulator/joint_dynamics/** -text

# Supervisor-handoff figures, PDFs and manifests are byte-hashed.
reports/simulator/supervisor_handoff/** -text

# Markdown sources are hashed in the handoff manifest; force stable LF checkout.
docs/HANDOFF_*.md text eol=lf
