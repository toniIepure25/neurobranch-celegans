# Large / externally licensed content (provenance is recorded in docs and manifests)
data/raw/*
!data/raw/.gitkeep
references/external/
artifacts/checkpoints/*.pt
artifacts/checkpoints/*.pth
artifacts/cache/
# Per-run weights and predictions are regenerated by the CLI; keeping them out of
# Git avoids a 100+ MB repository. They remain on disk in this working copy.
artifacts/**/model.pt
artifacts/**/test_predictions.npz

# Generated heavy outputs
figures/*.gif
reports/*.pdf
reports/phase2b_optogenetic_atlas/randi_trial_table.csv.gz
reports/phase2b_optogenetic_atlas/benchmark_oof_*.csv.gz

