# Large / externally licensed content (provenance is recorded in docs and manifests)
data/raw/*
!data/raw/.gitkeep
references/external/
artifacts/checkpoints/*.pt
artifacts/checkpoints/*.pth
artifacts/cache/
# Per-run weights and predictions are regenerated by the CLI; keeping them out of
# Git avoids a 100+ MB repository. They remain on disk in this working copy.
artifacts/**/model.pt
artifacts/**/test_predictions.npz

# Generated heavy outputs
figures/*.gif
reports/*.pdf
reports/phase2b_optogenetic_atlas/randi_trial_table.csv.gz
reports/phase2b_optogenetic_atlas/benchmark_oof_*.csv.gz
reports/phase3/randi_trial_table_phase3.csv.gz
# Phase 8 row-level/raw-derived artifacts stay local; aggregate results are committed.
reports/phase8/cache/
reports/phase8/predictions.parquet
reports/phase8/selection_log.jsonl
reports/phase8/models/
reports/*_quick/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Simulator weights are regenerated locally; metadata and hashes are committed.
reports/simulator/latent_encoders/*.pt
reports/simulator/demo/*.npz
artifacts/runs/blocked_suite/phase6/**/*.pt
